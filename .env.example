# Copia este archivo a .env.local y completa los valores.
# La validación vive en src/shared/config/env.ts: si falta algo requerido, la app no arranca.

# --- Público (se incluye en el bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Servidor (nunca con prefijo NEXT_PUBLIC_) ---
# Solo para jobs de servidor (ingesta). Salta RLS: jamás usarla en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth de Google (login + importación histórica de Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secretos de mínimo 32 caracteres. Generar con: openssl rand -base64 48
CRON_SECRET=
INGEST_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=

# Fallback opcional de IA para parsing
GEMINI_API_KEY=
